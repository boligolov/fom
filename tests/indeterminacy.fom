(fom test-indeterminacy-provenance
  {:kind :test}

  (node alice {:type :person})
  (node ivan {:type :person})
  (node petr {:type :person})
  (node ref-slot {:type :unresolved-reference})

  (scope p1 {:mode :precisification})
  (scope p2 {:mode :precisification})

  (subgraph proposition-p
    (proposition-content))

  (subgraph secret-content
    (secret-proposition))

  (scope epistemic-unknown
    {:owner alice}
    (unknown
      (home ivan)
      {:indeterminacy-source :missing-evidence}))

  (constraint reference-ambiguity
    (ambiguity
      {:target ref-slot
       :candidates [ivan petr]
       :indeterminacy-source :reference-ambiguity}))

  (constraint vague-tall
    (borderline
      {:content (tall ivan)
       :precisifications [p1 p2]
       :indeterminacy-source :vagueness}))

  (scope source-a
    (accept proposition-p))

  (scope source-b
    (reject proposition-p))

  (constraint conflicting-sources
    (unresolved
      {:content proposition-p
       :evidence-scopes [source-a source-b]
       :indeterminacy-source :source-conflict}))

  (constraint withheld-secret
    (unknown
      secret-content
      {:indeterminacy-source :withheld}))

  (constraint required-unknown
    (fixed-unknown
      secret-content
      {:indeterminacy-source :fixed-unknown}))
)
