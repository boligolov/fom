(fom test-vagueness-comparatives
  {:kind :test
   :language :ru}

  (node ivan {:type :person})
  (node petr {:type :person})
  (node group {:type :group})

  (node height-scale {:type :scale})
  (node context-adults {:type :comparison-class})
  (node ivan-height {:type :degree})
  (node petr-height {:type :degree})
  (node threshold-a {:type :threshold})
  (node threshold-b {:type :threshold})

  (rel deg-ivan degree
    {:subject ivan
     :dimension :height
     :scale height-scale
     :value ivan-height})

  (rel deg-petr degree
    {:subject petr
     :dimension :height
     :scale height-scale
     :value petr-height})

  (constraint ivan-taller
    (> ivan-height petr-height))

  (scope tall-precisification-a
    {:mode :precisification}
    (accept
      (threshold
        {:predicate :tall
         :comparison-class context-adults
         :value threshold-a}))
    (accept (tall ivan)))

  (scope tall-precisification-b
    {:mode :precisification}
    (accept
      (threshold
        {:predicate :tall
         :comparison-class context-adults
         :value threshold-b}))
    (reject (tall ivan)))

  (constraint ivan-borderline-tall
    (borderline
      {:content (tall ivan)
       :precisifications
       [tall-precisification-a
        tall-precisification-b]
       :source :vagueness}))

  (constraint much-taller
    (contextually-large
      (difference ivan-height petr-height)))

  (pattern tallest-in-group [?x]
    (where
      (member-of ?x group))
    (require
      (>= ivan-height
          (degree-of ?x :height))))

  (constraint ivan-tallest
    (for-each [?x]
      (where
        (member-of ?x group))
      (require
        (>= ivan-height
            (degree-of ?x :height)))))
)
