(fom test-counterfactual-causation
  {:kind :test
   :language :ru}

  (node rain-event {:type :event})
  (node match-held-state {:type :state})
  (node match-cancellation {:type :event})
  (node short-circuit {:type :event})
  (node fire {:type :event})
  (node fire-investigation-evidence {:type :evidence})
  (node fire-a {:type :event})
  (node fire-b {:type :event})
  (node house-destroyed {:type :state})

  (scope reality
    {:mode :reality}
    (accept rain-event)
    (reject match-held-state))

  (scope no-rain-counterfactual
    {:mode :counterfactual
     :imports [reality]
     :inherits-status-from reality
     :inherit-mode :overlay}
    (reject rain-event)
    (accept match-held-state))

  (rel cf1 counterfactual-alternative
    {:base reality
     :alternative no-rain-counterfactual
     :override (not rain-event)})

  (rel dep1 counterfactually-depends-on
    {:outcome match-held-state
     :condition (not rain-event)
     :scope no-rain-counterfactual})

  (scope causal-hypothesis
    {:mode :analysis}
    (accept
      (causes rain-event match-cancellation)
      {:certainty :plausible}))

  (subgraph causal-claim
    (rel cause-fire causes
      {:cause short-circuit
       :effect fire}))

  (subgraph possible-cause
    (possible
      {:content causal-claim
       :base fire-investigation-evidence}))

  (rel temporal-only before
    {:left short-circuit
     :right fire})

  (constraint no-temporal-collapse
    (not
      (entails-by-default
        temporal-only
        cause-fire)))

  (scope overdetermination
    {:mode :reality}
    (accept fire-a)
    (accept fire-b)
    (accept house-destroyed))

  (scope remove-fire-a
    {:mode :counterfactual
     :inherits-status-from overdetermination
     :inherit-mode :overlay}
    (reject fire-a)
    (accept fire-b)
    (accept house-destroyed))

  (constraint but-for-not-definition
    (not
      (definitionally-equivalent
        (cause fire-a house-destroyed)
        (counterfactual-dependence house-destroyed fire-a))))
)
