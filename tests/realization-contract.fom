(fom test-realization-contract
  {:kind :test}

  (node person-x {:type :person})
  (node guests {:type :group})
  (node source-pun-form {:type :signal})

  (constraint gender-unknown
    (fixed-unknown
      (gender person-x)))

  (subgraph arrival
    (rel arrive-1 arrived
      {:actor person-x
       :time :yesterday}))

  (constraint no-forced-gender
    (preserve
      (gender person-x)
      {:aspect :unknown
       :strength :required}))

  (subgraph reading-a
    (rel role-a guest-participant
      {:referent guests}))

  (subgraph reading-b
    (rel role-b meal-food
      {:referent guests}))

  (constraint pun-function
    (preserve
      {:readings [reading-a reading-b]
       :coactivation true}
      {:aspect :function
       :strength :required}))

  (constraint literal-form-not-required
    (preserve
      source-pun-form
      {:aspect :form
       :strength :optional}))

  (node weather-detail
    {:type :realization-slot
     :freedom :free})

  (constraint invention-audit
    (licensed-only
      {:must-not-resolve [gender-unknown]
       :must-preserve [pun-function]
       :free-slots [weather-detail]}))
)
