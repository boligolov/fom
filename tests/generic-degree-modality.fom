(fom test-generic-degree-modality
  {:kind :test}

  (node bird-kind {:type :kind})
  (node biological-normality {:type :normality-context})
  (node penguin {:type :kind})

  (subgraph birds-fly-generic
    (generic
      {:kind bird-kind
       :property (can-fly)
       :normality-context biological-normality}))

  (rel penguin-subtype subtype-of
    {:child penguin :parent bird-kind})

  (subgraph penguin-exception
    (generic
      {:kind penguin
       :property (not (can-fly))
       :normality-context biological-normality}))

  (node ivan {:type :person})
  (node lateness-scale {:type :scale})
  (node ivan-lateness {:type :degree})
  (node lateness-threshold {:type :threshold})

  (subgraph almost-late
    (rel lateness-degree degree
      {:subject ivan
       :scale lateness-scale
       :value ivan-lateness})
    (constraint target-not-attained
      (not (late ivan)))
    (constraint near-threshold
      (near ivan-lateness lateness-threshold)))

  (node maria {:type :person})
  (node exam {:type :event})
  (node exam-score-scale {:type :scale})
  (node maria-score {:type :degree})
  (node pass-threshold {:type :threshold})

  (scope reality {:mode :reality})

  (subgraph barely-passed
    (accept reality (passed maria exam))
    (rel exam-degree degree
      {:subject (performance maria exam)
       :scale exam-score-scale
       :value maria-score})
    (constraint near-pass-boundary
      (near maria-score pass-threshold)))

  (node tea {:type :substance})
  (node person {:type :person})
  (node temperature-scale {:type :scale})
  (node tea-temperature {:type :degree})
  (node drinkable-threshold {:type :threshold})

  (subgraph too-hot-to-drink
    (rel tea-degree degree
      {:subject tea
       :scale temperature-scale
       :value tea-temperature})
    (constraint excessive-for-goal
      (above tea-temperature drinkable-threshold))
    (rel heat-prevents prevents
      {:state (temperature tea tea-temperature)
       :goal (drink person tea)}))

  (node water {:type :substance})
  (node water-amount {:type :degree})
  (node survival-water-threshold {:type :threshold})

  (subgraph enough-water
    (rel water-amount-rel amount
      {:substance water :value water-amount})
    (constraint sufficient
      (at-least water-amount survival-water-threshold))
    (rel survival-threshold threshold-for
      {:threshold survival-water-threshold
       :goal (survive person)}))

  (node epistemic-evidence {:type :modal-base})
  (scope speaker-model {:mode :epistemic})

  (subgraph may-be-home
    (possible
      {:content (home ivan)
       :base epistemic-evidence
       :anchor speaker-model}))

  (node applicable-rules {:type :modal-base})
  (scope normative-model {:mode :normative})

  (subgraph must-be-home
    (necessary
      {:content (home ivan)
       :base applicable-rules
       :anchor normative-model}))

  (node door {:type :object})
  (node ivan-capabilities {:type :modal-base})
  (node current-circumstances {:type :context})

  (subgraph can-open-door
    (possible
      {:content (open ivan door)
       :base ivan-capabilities
       :anchor current-circumstances})
    (rel door-control controls
      {:agent ivan
       :transition (closed-to-open door)}))
)
