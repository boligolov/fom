(fom test-scope-overlay-shadow
  {:kind :test}

  (subgraph p-content
    (proposition-p))

  (subgraph q-content
    (proposition-q))

  (subgraph r-content
    (proposition-r))

  (scope base
    {:mode :reality}
    (accept p-content)
    (accept q-content))

  (scope child
    {:inherits-status-from base
     :inherit-mode :overlay}
    (uncommit p-content))

  (constraint expected-child-view
    (preserve
      {:scope child
       :content-p p-content
       :status-P :uncommitted
       :content-q q-content
       :status-Q :accept}
      {:strength :required}))

  (scope base-a
    (accept r-content))

  (scope base-b
    (reject r-content))

  (scope merged
    {:inherits-status-from [base-a base-b]
     :inherit-mode :overlay})

  (constraint preserve-base-conflict
    (unresolved
      {:scope merged
       :content r-content
       :indeterminacy-source :source-conflict}))
)
