(fom test-evidentiality-source-reliability
  {:kind :test
   :language :ru}

  (node train {:type :vehicle})
  (node ivan {:type :person})
  (node speaker {:type :person})
  (node alice {:type :person})
  (node bob {:type :person})
  (node train-schedules {:type :domain})
  (node medical-diagnosis {:type :domain})

  (subgraph train-left
    (rel departed-1 departed
      {:vehicle train}))

  (scope ivan-report
    {:source ivan}
    (accept train-left))

  (scope speaker-after-report
    {:owner speaker}
    (accept
      (reported ivan train-left)
      {:certainty :high})
    (unknown
      train-left
      {:indeterminacy-source :missing-evidence}))

  (rel visual-evidence perceived
    {:observer speaker
     :modality :vision
     :content train-left})

  (scope speaker-direct
    {:owner speaker}
    (accept train-left
      {:certainty :high
       :evidence visual-evidence}))

  (node hearsay-source
    {:type :source
     :specificity :unspecified})

  (rel hearsay-report reported
    {:source hearsay-source
     :content train-left})

  (scope source-model
    {:owner speaker}
    (accept
      (reliable {:source ivan
                 :domain train-schedules})
      {:degree :high})
    (unknown
      (reliable {:source ivan
                 :domain medical-diagnosis})))

  (scope alice-report
    {:source alice}
    (accept train-left))

  (scope bob-report
    {:source bob}
    (reject train-left))

  (scope synthesis
    {:mode :analysis}
    (unknown
      train-left
      {:indeterminacy-source :source-conflict
       :evidence [alice-report bob-report]}))

  (constraint reliability-not-truth
    (not
      (definitionally-equivalent
        (reliable {:source ivan
                   :domain train-schedules})
        (true-everything-said-by ivan))))
)
