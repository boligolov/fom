(fom test-binding
  {:kind :test}

  (node ivan {:type :person})
  (node petr {:type :person})
  (node oleg {:type :person})
  (node external-oleg {:type :person})

  (pattern loves-own-mother [?x ?y]
    (where
      (person ?x)
      (mother-of ?y ?x))
    (require
      (loves ?x ?y)))

  (node pronoun-1 {:type :signal-fragment :form "он"})
  (node ref-slot-1 {:type :unresolved-reference})

  (rel pronoun-reference refers-to
    {:signal pronoun-1 :target ref-slot-1})

  (constraint pronoun-candidates
    (one-of
      {:target ref-slot-1
       :candidates [ivan petr]}))

  (pattern farmer-donkey [?x ?y]
    (where
      (farmer ?x)
      (donkey ?y)
      (owns ?x ?y))
    (require
      (beats ?x ?y)))

  (node mention-same-man
    {:type :signal-fragment
     :form "тот самый человек"})

  (constraint same-man
    (presuppose
      {:prior-referent :required
       :salience :required}))

  (scope oleg-belief
    {:owner oleg
     :center oleg}
    (accept (winner (self))))

  (scope oleg-belief-de-re
    {:owner oleg}
    (accept (winner external-oleg)))
)
