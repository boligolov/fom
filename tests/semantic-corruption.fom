(fom test-semantic-corruption
  {:kind :test}

  (node lena {:type :person})
  (node victor {:type :person})
  (node letter {:type :object})
  (node letter-read {:type :checkpoint})

  (subgraph base-content
    (rel leave-event leaves
      {:actor lena
       :time :tomorrow}))

  (scope victor-before
    {:owner victor}
    (accept (lena-remains)
      {:certainty :high}))

  (constraint disclosure
    (disclosure
      base-content
      {:prohibited-before letter-read
       :required-after letter-read}))

  (subgraph restrained-reaction
    (rel fold-action folds-carefully
      {:actor victor
       :object letter})
    (rel fold-evidence evidence-for
      {:evidence (folds-carefully victor letter)
       :conclusion (distress victor)
       :explicitness :inferable}))

  (constraint corruption-content
    (expected-diff {:content :contradicted}))

  (constraint corruption-certainty
    (expected-diff {:epistemic-status :weakened}))

  (constraint corruption-explicitness
    (expected-diff
      {:content :preserved
       :explicitness :strengthened
       :inference-path :lost}))

  (constraint corruption-timing
    (expected-diff
      {:content :preserved
       :timing :early
       :trajectory :contradicted}))

  (constraint corruption-focus
    (expected-diff
      {:content :preserved
       :focus :weakened}))

  (constraint corruption-affect
    (expected-diff
      {:content :preserved
       :affect :contradicted}))

  (constraint corruption-inference
    (expected-diff
      {:event :preserved
       :signal-meaning :contradicted
       :inference-path :broken}))

  (constraint corruption-fixed-unknown
    (expected-diff
      {:fixed-unknown :violated
       :invention :unlicensed}))

  (constraint corruption-presupposition
    (expected-diff
      {:content :preserved
       :presupposition :invented
       :prior-state :contradicted}))
)
