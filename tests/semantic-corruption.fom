(fom test-semantic-corruption
  {:kind :test}

  (node lena {:type :person})
  (node victor {:type :person})
  (node letter {:type :object})

  (subgraph base-content
    (rel leaves
      {:actor lena
       :time :tomorrow}))

  (scope victor-before
    {:owner victor}
    (accept (lena-remains)
      {:certainty :high}))

  (constraint disclosure
    (disclosure
      base-content
      {:before :letter-read :prohibited
       :after :letter-read :required}))

  (subgraph restrained-reaction
    (rel folds-carefully
      {:actor victor
       :object letter})
    (rel evidence-for
      {:evidence (folds-carefully victor letter)
       :conclusion (distress victor)
       :explicitness :inferable}))

  ;; Expected corruption classes for validators / diff tools.

  (node corruption-content
    {:expected-diff {:content :contradicted}})

  (node corruption-certainty
    {:expected-diff {:epistemic-status :weakened}})

  (node corruption-explicitness
    {:expected-diff {:content :preserved
                     :explicitness :strengthened
                     :inference-path :lost}})

  (node corruption-timing
    {:expected-diff {:content :preserved
                     :timing :early
                     :trajectory :contradicted}})

  (node corruption-focus
    {:expected-diff {:content :preserved
                     :focus :weakened}})

  (node corruption-affect
    {:expected-diff {:content :preserved
                     :affect :contradicted}})

  (node corruption-inference
    {:expected-diff {:event :preserved
                     :signal-meaning :contradicted
                     :inference-path :broken}})

  (node corruption-fixed-unknown
    {:expected-diff {:fixed-unknown :violated
                     :invention :unlicensed}})

  (node corruption-presupposition
    {:expected-diff {:content :preserved
                     :presupposition :invented
                     :prior-state :contradicted}})
)
