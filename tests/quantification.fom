(fom test-quantification
  {:kind :test}

  (node students {:type :group})
  (node book {:type :object})
  (node piano {:type :object})
  (node relevant-people {:type :group})
  (node arrival-ratio {:type :degree})
  (node bird-kind {:type :kind})

  (pattern student-read [?x]
    (where
      (member-of ?x students))
    (require
      (read ?x book)))

  (constraint all-students-read
    (for-each [?x]
      (where
        (member-of ?x students))
      (require
        (read ?x book))))

  (rel collective-lift lift
    {:actor students :object piano})

  (subgraph almost-all-arrived
    (rel arrival-ratio-rel ratio
      {:numerator (count (arrived-members relevant-people))
       :denominator (count relevant-people)
       :value arrival-ratio})
    (constraint below-target
      (< arrival-ratio 1))
    (constraint close-to-target
      (contextually-close-to arrival-ratio 1)))

  (rel bird-characteristic characteristic-of
    {:kind bird-kind
     :property (can-fly)})
)
